    "@vitest/coverage-v8": "5.0.3",
    "cspell": "^10.3.6",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.23.1"
  },
  "packageManager": "pnpm@11.13.1"
